PORT=3000
NODE_ENV=development

# Cloudinary – get from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS – comma-separated frontend origins (Vercel + localhost)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Optional: Upstash Redis for persistent gallery short links + distributed rate-limit
# Create at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Optional: Sentry
SENTRY_DSN=
